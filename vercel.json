{
  "buildCommand": "pnpm run typecheck && pnpm -r --if-present run build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "framework": "other",
  "outputDirectory": "artifacts/api-server/dist",
  "env": [
    {
      "key": "ANTHROPIC_API_KEY",
      "description": "Anthropic API key for AI service"
    },
    {
      "key": "DATABASE_URL",
      "description": "PostgreSQL connection string"
    },
    {
      "key": "NODE_ENV",
      "value": "production"
    }
  ]
}
